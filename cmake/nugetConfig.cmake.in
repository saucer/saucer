@PACKAGE_INIT@

add_library(@nuget_NAME@ STATIC IMPORTED)
set_target_properties(@nuget_NAME@ PROPERTIES
    IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@nuget_NAME@-@nuget_VERSION@/@package_LIBRARY@"
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/@nuget_NAME@-@nuget_VERSION@"
)
